# S3 — Application-layer JWT RS256 + in-process authz
COMPOSE_PROFILES=
SCENARIO=S3
APP_JWT_MODE=app
APP_AUTH_MODE=app
APP_JWT_ALG=RS256
MESH_UPSTREAM=app:8080
ENVOY_CONFIG=
# NGINX_RATE derived from measured lambda*=75: 1.5 x lambda*, rounded up to 10 r/s, burst ~1.5x rate. Sheds floods, not benign load.
NGINX_RATE=120
NGINX_BURST=180
APP_OFFLOAD=false
APP_BUSINESS_CPU_MS=12
