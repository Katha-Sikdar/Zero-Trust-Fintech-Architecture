# S4es — RQ2 arm: sidecar JWT with ES256
COMPOSE_PROFILES=S4
SCENARIO=S4es
APP_JWT_MODE=delegated
APP_AUTH_MODE=none
APP_JWT_ALG=ES256
MESH_UPSTREAM=envoy:8000
ENVOY_CONFIG=envoy-jwt.yaml
# NGINX_RATE derived from measured lambda*=75: 1.5 x lambda*, rounded up to 10 r/s, burst ~1.5x rate. Sheds floods, not benign load.
NGINX_RATE=120
NGINX_BURST=180
APP_OFFLOAD=false
APP_BUSINESS_CPU_MS=12
