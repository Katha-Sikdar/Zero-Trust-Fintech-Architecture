# S0rl — Control arm: baseline (no JWT, no authz) WITH the same gateway rate
# limit as S3-S5. Without this, every latency/FPR comparison against S0 confounds
# the enforcement effect with the presence of a rate limiter: S0 admits all
# offered load while S3+ shed above the derived limit. S0rl holds the limiter constant
# so the enforcement point is the only variable.
COMPOSE_PROFILES=
SCENARIO=S0rl
APP_JWT_MODE=none
APP_AUTH_MODE=none
APP_JWT_ALG=RS256
MESH_UPSTREAM=app:8080
ENVOY_CONFIG=
# NGINX_RATE derived from measured lambda*=75: 1.5 x lambda*, rounded up to 10 r/s, burst ~1.5x rate. Sheds floods, not benign load.
NGINX_RATE=120
NGINX_BURST=180
APP_OFFLOAD=false
APP_BUSINESS_CPU_MS=12
