# S0rl — Control arm: baseline (no JWT, no authz) WITH the same gateway rate
# limit as S3-S5. Without this, every latency/FPR comparison against S0 confounds
# the enforcement effect with the presence of a rate limiter: S0 admits all
# offered load while S3+ shed traffic at 200 r/s. S0rl holds the limiter constant
# so the enforcement point is the only variable.
COMPOSE_PROFILES=
SCENARIO=S0rl
APP_JWT_MODE=none
APP_AUTH_MODE=none
APP_JWT_ALG=RS256
MESH_UPSTREAM=app:8080
ENVOY_CONFIG=
NGINX_RATE=200
NGINX_BURST=400
APP_OFFLOAD=false
APP_BUSINESS_CPU_MS=2
