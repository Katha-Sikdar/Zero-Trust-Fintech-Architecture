# S6fo — A10 comparison: identical to S6 but Envoy ext_authz fail-OPEN
COMPOSE_PROFILES=S6fo
SCENARIO=S6fo
APP_JWT_MODE=delegated
APP_AUTH_MODE=delegated
APP_JWT_ALG=RS256
MESH_UPSTREAM=envoy:8000
ENVOY_CONFIG=envoy-authz-failopen.yaml
# NGINX_RATE derived from measured lambda*=75: model-driven adaptive limit held near lambda* (deliberately tighter), burst ~1.5x rate.
NGINX_RATE=85
NGINX_BURST=130
APP_OFFLOAD=false
APP_BUSINESS_CPU_MS=12
